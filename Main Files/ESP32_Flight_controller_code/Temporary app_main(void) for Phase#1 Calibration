void app_main(void) {
    printf("FlightCtrl: ==========================================\n");
    printf("FlightCtrl:         ESC CALIBRATION MODE ACTIVE       \n");
    printf("FlightCtrl:   [!] ALERT: REMOVE ALL PROPELLERS FIRST [!]\n");
    printf("FlightCtrl: ==========================================\n");

    // 1. Call your real LEDC driver initializer
    pwm_init(); 

    printf("FlightCtrl: >> Broadcasting MAX Throttle (2000us)...\n");
    
    // 2. Loop through channels 0 to 3 to send the 2000us signal to all 4 motors
    for (int i = 0; i < 4; i++) {
        set_throttle(i, 2000);
    }
    
    printf("FlightCtrl: >> NOW PLUG IN YOUR 12.6V XT60 BATTERY! (You have 15 seconds)\n");
    vTaskDelay(pdMS_TO_TICKS(15000));

    printf("FlightCtrl: >> Catching high-point chimes... Dropping to MIN Throttle (1000us)...\n");
    
    // 3. Drop all 4 motor channels down to 1000us
    for (int i = 0; i < 4; i++) {
        set_throttle(i, 1000);
    }

    printf("FlightCtrl: >> SUCCESS: Calibration complete! Safely locked into static loop.\n");

    // Static lock to keep background FreeRTOS tasks from triggering a watchdog reset
    while(1) { 
        vTaskDelay(pdMS_TO_TICKS(1000)); 
    }
}
